PORT=5000
MONGO_URI=mongodb+srv://<username>:<password>@<cluster-host>/aifittrack_poovarasan_team?retryWrites=true&w=majority
JWT_SECRET=replace_with_poovarasan_team_jwt_secret
GEMINI_API_KEY=replace_with_poovarasan_team_gemini_api_key
GEMINI_MODEL=gemini-3.8-flash

# Semantic Search / MongoDB Atlas Search
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_EMBEDDING_DIMENSIONS=768
EMBEDDING_BACKFILL_BATCH_SIZE=20
ATLAS_SEARCH_INDEX=workout_text_search
ATLAS_VECTOR_INDEX=workout_vector_search
ATLAS_SEARCH_ENABLED=false
ATLAS_VECTOR_SEARCH_ENABLED=false
